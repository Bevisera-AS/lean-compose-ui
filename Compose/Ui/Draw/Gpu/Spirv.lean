/-!
# SPIR-V blob helpers (`Compose/Ui/Draw/Gpu/Spirv.lean`)

Decoding for the hex-embedded SPIR-V shader blobs in `Gpu/SpirvBlobs.lean`
(generated by `scripts/gen-shaders.sh` from the GLSL twins in `shaders/`).
The blobs are small (~1–3 KB each) and decoded once per pipeline build, so
a compact hex `String` beats a giant `ByteArray` literal — one token per
blob, fast to elaborate, and greppable.
-/

namespace Compose.Draw.Gpu.Spirv

/-- Decode a lowercase-hex string into bytes. Input is generator-produced
and assumed well-formed (even length, `[0-9a-f]` only); stray characters
decode as garbage rather than failing — `headerOk` below catches a
malformed blob at compile time. -/
def ofHex (s : String) : ByteArray := Id.run do
  let nibble (c : Char) : UInt8 :=
    if c ≤ '9' then (c.toNat - '0'.toNat).toUInt8
    else (c.toNat - 'a'.toNat + 10).toUInt8
  let mut out := ByteArray.emptyWithCapacity (s.utf8ByteSize / 2)
  let mut hi : Option UInt8 := none
  for c in s.toList do
    match hi with
    | none => hi := some (nibble c)
    | some h =>
      out := out.push (h <<< 4 ||| nibble c)
      hi := none
  return out

#guard ofHex "0302230700010600" == ⟨#[0x03, 0x02, 0x23, 0x07, 0x00, 0x01, 0x06, 0x00]⟩
#guard ofHex "ff00" == ⟨#[0xff, 0x00]⟩
#guard (ofHex "").size == 0

/-- A plausible SPIR-V module: the magic number `0x07230203` little-endian
up front, whole 32-bit words, and at least the 5-word header. -/
def headerOk (b : ByteArray) : Bool :=
  b.size % 4 == 0 && b.size ≥ 20 &&
  b.get! 0 == 0x03 && b.get! 1 == 0x02 && b.get! 2 == 0x23 && b.get! 3 == 0x07

#guard headerOk (ofHex "03022307000106000100000000000000ff000000") == true
#guard headerOk (ofHex "030223070001060001000000000000") == false -- not word-aligned
#guard headerOk (ofHex "0302230700010600") == false -- shorter than the header
#guard headerOk (ofHex "07230203000106000100000000000000ff000000") == false -- big-endian magic

end Compose.Draw.Gpu.Spirv

end
